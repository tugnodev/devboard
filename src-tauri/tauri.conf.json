{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devboard",
  "version": "0.1.0",
  "identifier": "com.tugnodev.devboard",
  "build": {
    "beforeDevCommand": "bun dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "devboard",
        "width": 414,
        "height": 896,
        "transparent": true
      },
      {
        "label": "overlay",
        "title": "Overlay",
        "url": "/overlay",
        "visible": false,
        "fullscreen": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
