{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devboard",
  "version": "0.1.0",
  "identifier": "com.tugnodev.devboard",
  "build": {
    "beforeDevCommand": "bun dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "devboard",
        "width": 414,
        "height": 896,
        "transparent": true,
        "backgroundColor": {
          "blue": 0,
          "green": 0,
          "red": 0,
          "alpha": 127
        }
      },
      {
        "label": "overlay",
        "title": "Overlay",
        "url": "/overlay",
        "visible": false,
        "fullscreen": true,
        "transparent": true,
        "backgroundColor" : {
          "alpha": 64,
          "blue": 0,
          "green": 0,
          "red": 0
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
